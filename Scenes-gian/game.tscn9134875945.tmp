[sub_resource type="GDScript" id="GDScript_o5yvi"]
script/source = "extends Node2D


func _ready():	
	pass
	
func _process(delta: float) -> void:
	if Input.is_action_just_pressed(\"Boss_Attack\"):
		print(\"kalbo\")

func _on_midi_player_midi_event(channel: Variant, event: Variant) -> void:
	
	if channel.number == 1 and event.type == 144:
		print(\"Note\", event.note)
		
		if event.note == 47:
			print(\"BWOAH\")
		
		if event.note == 48:
			print(\"BWUAAHHRRRGGGHH\")
			
		if event.note == 49:
			print(\"tsar\")
		
		if event.note == 50:
			print(\"tak\")
		else: print()
		
"

